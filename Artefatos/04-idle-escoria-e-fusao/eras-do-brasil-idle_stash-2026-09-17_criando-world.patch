@@ -0,0 +1,22 @@
+package game
+
+type ZoneID string
+type RiskLevel string
+
+const (
+	RiskSegura    RiskLevel = "segura"
+	RiskDisputada RiskLevel = "disputada"
+	RiskMortal    RiskLevel = "mortal"
+)
+
+var ValidRisk = map[RiskLevel]bool{
+	RiskSegura: true, RiskDisputada: true, RiskMortal: true,
+}
+
+type Zone struct {
+	ID   ZoneID
+	Name string
+	Tier int
+	Risk RiskLevel
+	Hub  bool
+}
diff --git a/backend/internal/gamedata/loader.go b/backend/internal/gamedata/loader.go
new file mode 100644
index 0000000..2d2995a
--- /dev/null
+++ b/backend/internal/gamedata/loader.go
@@ -0,0 +1,35 @@
+package gamedata
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+func loadJSON[T any](path string) (T, error) {
+	var out T
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return out, err
+	}
+	err = json.Unmarshal(raw, &out)
+	return out, err
+}
+
+func LoadZoneMaps(dir string) ([]ZoneMap, error) {
+	paths, err := filepath.Glob(filepath.Join(dir, "*_zones.json"))
+	if err != nil {
+		return nil, err
+	}
+
+	maps := make([]ZoneMap, 0, len(paths))
+	for _, path := range paths {
+		zm, err := loadJSON[ZoneMap](path)
+		if err != nil {
+			return nil, fmt.Errorf("carregando %s: %w", path, err)
+		}
+		maps = append(maps, zm)
+	}
+	return maps, nil
+}
